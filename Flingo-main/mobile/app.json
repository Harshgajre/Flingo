{
  "expo": {
    "name": "Flingo",
    "slug": "flingo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "flingo",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flingo.app"
    },
    "android": {
      "package": "com.flingo.app",
      "adaptiveIcon": {
        "backgroundColor": "#FF3366",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share posts and stories.",
          "cameraPermission": "The app accesses your camera to take photos and stories."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cf34e5aa-9967-4ba7-a58f-b0850137b146"
      }
    }
  }
}
